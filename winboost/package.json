{
  "name": "winboost",
  "version": "3.1.0",
  "description": "A local-first Windows maintenance suite with ClamAV malware scanning, system recovery, safety safeguards, and a polished animated interface.",
  "author": {
    "name": "malick186",
    "url": "https://github.com/malick186"
  },
  "license": "MIT",
  "homepage": "https://github.com/malick186/Clean-My-Windows",
  "repository": {
    "type": "git",
    "url": "https://github.com/malick186/Clean-My-Windows.git",
    "directory": "winboost"
  },
  "bugs": {
    "url": "https://github.com/malick186/Clean-My-Windows/issues"
  },
  "keywords": [
    "windows",
    "optimizer",
    "cleaner",
    "performance",
    "privacy",
    "maintenance",
    "desktop-app",
    "electron",
    "react",
    "system-utility"
  ],
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check-platform": "node ./scripts/check-platform.cjs",
    "preelectron:dev": "npm run check-platform",
    "electron:dev": "concurrently \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.winboost.app",
    "productName": "WinBoost",
    "artifactName": "WinBoost-${version}-Portable.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "signAndEditExecutable": false,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WinBoost",
      "installerIcon": "public/icon.png",
      "uninstallerIcon": "public/icon.png",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "systeminformation": "^5.33.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
