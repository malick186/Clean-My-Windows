{
  "name": "winboost",
  "version": "1.0.0",
  "description": "Manage, optimize, and supercharge your Windows experience. A free, open-source Windows optimization suite with 12 powerful tools.",
  "author": {
    "name": "malick186",
    "url": "https://github.com/malick186"
  },
  "license": "MIT",
  "homepage": "https://github.com/malick186/Clean-My-Windows",
  "repository": {
    "type": "git",
    "url": "https://github.com/malick186/Clean-My-Windows.git",
    "directory": "winboost"
  },
  "bugs": {
    "url": "https://github.com/malick186/Clean-My-Windows/issues"
  },
  "keywords": [
    "windows",
    "optimizer",
    "cleaner",
    "performance",
    "privacy",
    "maintenance",
    "desktop-app",
    "electron",
    "react",
    "system-utility"
  ],
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.winboost.app",
    "productName": "WinBoost",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WinBoost",
      "installerIcon": "public/icon.png",
      "uninstallerIcon": "public/icon.png",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
